# Copia este archivo a .env y completa. Luego: set -a; source .env; set +a
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# API de Patitaspe. En producción: https://patitaspe.com/api
# Para probar en tu compu antes de publicar: corre `node scripts/api-local.js` y usa http://localhost:8888/api
PATITAS_API=https://patitaspe.com/api

# Supabase (el mismo proyecto de la web; la llave anon solo permite insertar)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional: Google Calendar (cuenta de servicio con acceso al calendario de la clínica)
GOOGLE_CALENDAR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional: WhatsApp del equipo para derivaciones (solo números, ej. 51987569409)
WHATSAPP_EQUIPO=
